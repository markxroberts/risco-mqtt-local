{
  "name": "@markxroberts/risco-mqtt-local",
  "version": "2026.10.0-beta4",
  "description": "Node Risco Mqtt using local panel API",
  "main": "dist/lib/index.js",
  "types": "dist/lib/index.d.ts",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "watch": "tsc -w",
    "prepublishOnly": "npm test",
    "run": "tsc && node ./dist/main.js",
    "test": "node tests/proxy-recovery.cjs && node tests/behavior.cjs && node tests/startup.cjs",
    "pretest": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/markxroberts/risco-mqtt-local"
  },
  "keywords": [
    "risco",
    "alarm",
    "home-assistant",
    "mqtt",
    "iRISCO"
  ],
  "author": "Mark Roberts <mark.roberts30@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@markxroberts/risco-lan-bridge": "^0.16.22",
    "js-yaml": "^5.5.0",
    "lodash": "^4.18.1",
    "mqtt": "^5.16.1",
    "tiny-typed-emitter": "^2.1.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.27",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  },
  "files": [
    "/dist",
    "package.json",
    "README.md",
    "LICENSE",
    "config-sample.yaml"
  ],
  "bin": "./dist/main.js",
  "engines": {
    "node": ">=22"
  }
}
